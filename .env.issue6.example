# Optional Issue #6 settings. Do NOT replace an existing persistent .env.
# The server continues using %LOCALAPPDATA%\SignalLab\.env on Windows.
# Add only settings you want to change; preserve Telegram credentials/history.
# Proposed signal threshold; performance validation remains UNVERIFIED.
# Allowed: integer 90..100. Invalid/lower values block startup.
# It does not authorize any live order.
SIGNAL_FINAL_MIN_SCORE=90
# Only final-screen signals may trigger Telegram. Legacy watch/news Telegram flags are ignored.
TP1_MOVE_STOP_TO_BREAKEVEN=true
TP1_BREAKEVEN_MODE=ENTRY_FILL
PAPER_MAX_RISK_USD=6

# Optional self-managed LibreTranslate-compatible POST endpoint.
# Empty keeps original news with an explicit UNAVAILABLE translation state.
NEWS_TRANSLATION_URL=

# Requests are accepted only for IP addresses, localhost and this PC's name.
# Add a private DNS name you use to open the dashboard, comma separated.
ALLOWED_HOSTS=

# BingX / Gate.io: public market data only (no keys, no orders) in this build.
# Paper fills use the venue with the better entry among these (comma separated).
PAPER_VENUES=BINGX,GATEIO
