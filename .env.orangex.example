# Append only the required lines to your existing .env. Never replace your
# current settings or store.json. Do not commit real credentials.
ORANGEX_ENABLED=false
ORANGEX_MODE=READ_ONLY
# Request candidates, not proof of listing or order support.
ORANGEX_INSTRUMENTS=BTC-USDT-PERPETUAL,ETH-USDT-PERPETUAL,SOL-USDT-PERPETUAL
ORANGEX_REQUEST_TIMEOUT_MS=8000
# Trading-area examples reported from the official documentation. These are
# discovery queries, not settlement-asset names or an approval to trade.
ORANGEX_LISTING_CURRENCIES=BTC,ETH,SPOT
# The old singular ORANGEX_LISTING_CURRENCY is honored only when no plural
# setting exists. USDT lacks documented support and is never a default.
# PERPETUAL remains an opt-in unverified diagnostic candidate.
# Optional future authenticated read access; use an account API key with
# read permission only. Never enable trade or withdrawal permission.
# Private authentication remains blocked until official specifications are verified.
ORANGEX_CLIENT_ID=
ORANGEX_CLIENT_SECRET=
